# Released container version used by the image-based Compose files.
JULGATE_VERSION=0.6.1

# Required on the first start.
JULGATE_ADMIN_USER=admin
JULGATE_ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-16-characters

# Exactly 32 hexadecimal characters. Generate with: openssl rand -hex 16
JULGATE_GUACAMOLE_JSON_SECRET_KEY=replace-with-32-random-hex-characters

# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
# Store this separately from the Julgate data backup.
JULGATE_CREDENTIAL_KEY=replace-with-a-random-base64-key

# Bind only to loopback when an existing reverse proxy publishes Julgate.
JULGATE_BIND_ADDRESS=127.0.0.1
JULGATE_PORT=8088

# Set true when the browser reaches Julgate through HTTPS.
JULGATE_REQUIRE_SECURE_COOKIES=true
JULGATE_SESSION_HOURS=8
JULGATE_MAX_REQUEST_BODY_BYTES=536870912

# High-risk features are disabled unless explicitly enabled.
JULGATE_ENABLE_WEBSITE_PROXY=false
JULGATE_ENABLE_NETWORK_TOOLS=false
JULGATE_ENABLE_ARCHIVE_EXTRACTION=false

# DNS names for website proxy targets are disabled by default.
# Prefer literal private IP addresses. When DNS is required, enable it and
# provide a comma-separated exact allowlist.
JULGATE_ALLOW_WEBSITE_PROXY_DNS=false
JULGATE_WEBSITE_PROXY_ALLOWED_HOSTS=

# Optional home-network DNS configuration.
JULGATE_DNS_SERVER=10.10.0.1
JULGATE_DNS_SEARCH=example.home
