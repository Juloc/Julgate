# Released container version used by the image-based Compose files.
JULGATE_VERSION=0.7.8

# Required on the first start.
JULGATE_ADMIN_USER=admin
JULGATE_ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-16-characters

# Exactly 32 hexadecimal characters. Generate with: openssl rand -hex 16
JULGATE_GUACAMOLE_JSON_SECRET_KEY=replace-with-32-random-hex-characters

# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
# Store this separately from the Julgate data backup.
JULGATE_CREDENTIAL_KEY=replace-with-a-random-base64-key
# Set only during rotation; comma-separated previous keys are accepted.
JULGATE_CREDENTIAL_KEY_PREVIOUS=

# Only needed when importing a Matgate 0.6.1 data volume containing enc:1 credentials.
# Use the exact former MATGATE_SECRET_KEY value for one start. Julgate also unwraps
# credentials that an older Julgate version already enclosed in its own encryption.
# After migration to JULGATE_CREDENTIAL_KEY this value can be removed.
JULGATE_LEGACY_MATGATE_SECRET_KEY=

# Bind only to loopback when an existing reverse proxy publishes Julgate.
JULGATE_BIND_ADDRESS=127.0.0.1
JULGATE_PORT=8088

# Set true when the browser reaches Julgate through HTTPS.
JULGATE_REQUIRE_SECURE_COOKIES=true
JULGATE_SESSION_HOURS=8
JULGATE_MAX_REQUEST_BODY_BYTES=536870912

# Request limits are separate so interactive tabs do not exhaust the login guard.
JULGATE_RATE_LIMIT_LOGIN_PER_MINUTE=10
JULGATE_RATE_LIMIT_WRITES_PER_MINUTE=120
JULGATE_RATE_LIMIT_READS_PER_MINUTE=1200

# File-gateway operation and resource limits.
JULGATE_FILE_OPERATION_TIMEOUT_SECONDS=120
JULGATE_MAX_UPLOAD_BYTES=536870912
JULGATE_MAX_DOWNLOAD_BYTES=2147483648
JULGATE_MAX_DIRECTORY_ENTRIES=10000

# High-risk features are disabled unless explicitly enabled.
JULGATE_ENABLE_WEBSITE_PROXY=false
JULGATE_ENABLE_NETWORK_TOOLS=false
JULGATE_ENABLE_ARCHIVE_EXTRACTION=false
JULGATE_MAX_ARCHIVE_EXPANDED_BYTES=268435456
JULGATE_MAX_ARCHIVE_ENTRIES=4096
JULGATE_MAX_CONCURRENT_ARCHIVE_EXTRACTIONS=1

# Website proxy targets must use explicit permitted IP addresses.
# DNS hostnames are rejected to eliminate DNS-rebinding attacks.

# Optional home-network DNS configuration for RDP, SSH and file targets.
JULGATE_DNS_SERVER=10.10.0.1
JULGATE_DNS_SEARCH=example.home
