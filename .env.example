# Matgate deployment secrets. Copy to `.env` (which is gitignored) and fill in real values.
#
# Shared Guacamole JSON-auth key: Matgate signs launch tokens with it and the Guacamole
# webapp verifies them. It MUST be a strong, per-deployment random value — anyone who knows
# it can forge a token and open RDP/SSH/VNC to any host. Generate one with:
#   openssl rand -hex 16
# (exactly 32 hex characters). The old shipped default is now refused on both sides.
MATGATE_GUACAMOLE_JSON_SECRET_KEY=

# At-rest encryption key for stored device credentials (servers.json). Keep it OUTSIDE ./data and
# its backups, otherwise a stolen data volume also reveals the key. Generate with:
#   openssl rand -hex 32
MATGATE_SECRET_KEY=

# First-run admin password (only used to seed the initial admin account; ignored afterwards).
# MATGATE_ADMIN_PASSWORD=change-me-please

# Set to true once TLS is terminated at the edge to force Secure-only cookies + HSTS + HTTPS redirect.
# MATGATE_REQUIRE_HTTPS=false
